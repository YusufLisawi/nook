{
  "id": "clips",
  "name": "Clips",
  "symbol": "doc.on.clipboard",
  "entry": "index.html",
  "order": 44,
  "height": 360,
  "apiVersion": 2,
  "version": "2.0.0",
  "native": {
    "command": "bin/helper",
    "background": true,
    "permissions": [
      "clipboard",
      "files",
      "accessibility",
      "background"
    ]
  },
  "settings": [
    {
      "key": "clips.enabled",
      "label": "Capture clipboard history",
      "type": "toggle",
      "default": true
    },
    {
      "key": "capture.screenshots",
      "label": "Index screenshots and recordings",
      "type": "toggle",
      "default": true
    },
    {
      "key": "clips.days",
      "label": "Retention (days)",
      "type": "number",
      "default": 30,
      "min": 1,
      "max": 3650
    },
    {
      "key": "clips.maxItems",
      "label": "Unpinned items",
      "type": "number",
      "default": 500,
      "min": 1,
      "max": 10000
    },
    {
      "key": "clips.ignoredApps",
      "label": "Ignored applications (name or bundle ID per line)",
      "type": "textarea",
      "default": "1Password\nBitwarden\nKeychain Access\ncom.agilebits.onepassword7\ncom.1password.1password\ncom.bitwarden.desktop\ncom.apple.keychainaccess"
    },
    {
      "key": "clips.screenshotsFolder",
      "label": "Screenshot folder (approve it in Permissions)",
      "type": "text",
      "default": ""
    },
    {
      "key": "clips.ocr",
      "label": "Recognize screenshot text on this Mac",
      "type": "toggle",
      "default": true
    }
  ],
  "contributes": {
    "settings": [
      {
        "id": "preferences",
        "title": "Clips"
      }
    ]
  }
}
